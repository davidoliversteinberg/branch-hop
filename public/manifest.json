{
  "manifest_version": 3,
  "name": "Branch Hop",
  "version": "0.0.0",
  "description": "Hop between Axiom Play preview branches, keep favorites, and share branches with your team.",
  "key": "",
  "minimum_chrome_version": "123",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Branch Hop",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.vercel.app/*"
      ],
      "include_globs": [
        "https://axiom-play-git-*-optimizely-sandbox.vercel.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": [
    "https://*.vercel.app/*",
    "https://github.com/*",
    "https://api.github.com/*"
  ],
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Open Branch Hop"
    },
    "flip-branch": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Flip back to the previous branch on the same route"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
